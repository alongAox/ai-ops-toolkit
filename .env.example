# 复制为 .env.local 并填入真实值
# copy .env.example .env.local   (Windows)

# ===== OpenRouter（推荐：成本低，有免费额度）=====
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# 国内访问建议配置代理（Clash 常见端口 7890 / 7897）
# HTTPS_PROXY=http://127.0.0.1:7890

# 可选，OpenRouter 统计用
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=AI Analyzer

# ===== OpenAI 官方 API（可选，需绑卡充值；配置后优先于 OpenRouter）=====
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

# ===== Supabase（分析记录持久化 + 登录）=====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 客户端登录必填：Dashboard → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# 服务端 API 写入：Dashboard → API Keys → Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# 建表脚本见 supabase/migrations/001_analysis_history.sql（表名 analysis_history）
